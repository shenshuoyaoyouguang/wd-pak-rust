一百级鞋子黑水 : 50
一百级腰带黑水 : 50


[一百级武器黑水]
bonus$:  ({ 0, 0, 100, "属性道具", 1, 1, "武器所有相", "武器伤害", "武器所有技能", "武器忽视所有抗性", "武器忽视所有抗异常", "武器体质", "武器敏捷", "武器金相", "武器木相", "武器水相", "武器火相", "武器土相", "武器物理必杀率" })

